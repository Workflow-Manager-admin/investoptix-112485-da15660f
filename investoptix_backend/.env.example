# InvestOptix Backend Example Environment Variables
# Copy this file to .env and fill in the actual secret values as required.

# --- Server Port Configuration ---
PORT=5000
# Port for backend server to listen on (default: 5000)

# --- Session Security ---
SESSION_SECRET=your_secret_cookie_signing_key_here
# Secret key for signing cookies (use a strong random value in production)

# --- Zerodha Kite Connect API Credentials ---
KITE_API_KEY=d9hqdwpwqs1fpn9v
# Zerodha Kite Connect API Key
KITE_API_SECRET=zutgh8i03uanjfa16p1ef5hd9a8ne69g
# Zerodha Kite Connect API Secret

# --- OAuth Redirect Configuration ---
KITE_REDIRECT_URL=http://localhost:5000/api/auth/zerodha/callback
# URL where Kite Connect API will redirect after authentication.
# This should match the redirect URI set in Kite developer dashboard.

# (Optional) Base URLs for Kite (advanced override, normally not needed)
# KITE_BASE_OAUTH=https://kite.trade/connect/login
# KITE_BASE_API=https://api.kite.trade

# --- CORS Frontend Origin (Change if deploying frontend elsewhere) ---
FRONTEND_ORIGIN=http://localhost:3000
# Frontend base URL allowed for CORS (update if using different frontend address)
